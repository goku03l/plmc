# Copy to apps/api/.env  (Prisma + the API read it from there)
#
# Primary: a local PostgreSQL server on :5432
#   psql -U postgres -c "CREATE DATABASE summer;"
DATABASE_URL="postgresql://postgres:YOURPASSWORD@localhost:5432/summer?schema=public"
#   NOTE: URL-encode reserved characters in the password — '@' -> %40, ':' -> %3A,
#   '/' -> %2F, '#' -> %23. e.g. password  P@ss:1  becomes  P%40ss%3A1

# Alternative: the Dockerised Postgres from docker-compose.yml (host port 5433, needs WSL2)
# DATABASE_URL="postgresql://summer:summer@localhost:5433/summer?schema=public"

# API
PORT=4000
# In production, set this to the web app's deployed origin (no trailing slash,
# no path) — e.g. https://summer-web.onvoroa.app or a custom domain. The API
# only accepts browser requests from this exact origin.
CORS_ORIGIN=http://localhost:5173

# Procurement / RFQ portal
# Public URL of the web app — used to build supplier portal links in RFQ emails.
# Same value as CORS_ORIGIN in production.
APP_BASE_URL=http://localhost:5173
# Where uploaded supplier quote files are stored (relative to apps/api/).
# NOTE: this is local disk. On a platform without persistent disks (e.g. Voroa
# today), everything under this folder is wiped on every redeploy/restart —
# fine for a demo, not for real attachments in production until this moves to
# an external object store (S3-compatible).
UPLOAD_DIR=uploads
# UPLOAD_MAX_MB=500      # per-file cap for RFQ attachments and node documents (no type restriction, any file)
# Outbound email. Leave SMTP_HOST blank for local dev — the API then logs the
# email to its console instead of sending, and portal links still work.
MAIL_FROM="Summer Procurement <procurement@summer.local>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=            # set this in apps/api/.env only, never commit it

# Assistant (AI chat + write access over the project data — English / Hindi / Tamil)
# Without a key the /assistant page shows a "not configured" notice.
# DeepSeek is the default provider when set (cheap, Anthropic-compatible API);
# ANTHROPIC_API_KEY is only the fallback used when DEEPSEEK_API_KEY is empty.
DEEPSEEK_API_KEY=              # set in apps/api/.env only
ANTHROPIC_API_KEY=             # set in apps/api/.env only — fallback provider
# AGENT_MODEL=deepseek-flash   # default on DeepSeek; claude-sonnet-5 default on Anthropic
# AGENT_EFFORT=medium          # low | medium | high | xhigh | max
# AGENT_THINKING=on            # DeepSeek only — adds a reasoning pass (slower + pricier)

# Assistant voice + mic — Google Cloud (one API key covers both).
#   Text-to-Speech (Chirp 3: HD) — natural en/hi/ta voices. Without it the
#     browser voice is used (flat, often silent for Hindi/Tamil).
#   Speech-to-Text (v1) — transcribes the mic in all three languages at once,
#     so code-mixed "Tanglish"/"Hinglish" works. Without it the browser's
#     single-language recogniser is used.
#   The key needs BOTH "Cloud Text-to-Speech API" and "Cloud Speech-to-Text API"
#   enabled, and both allowed in the key's API restrictions.
GOOGLE_TTS_API_KEY=           # set in apps/api/.env only
# GOOGLE_STT_API_KEY=         # optional separate key for speech-to-text
# TTS_VOICE=Aoede             # any Chirp 3: HD voice (Aoede, Puck, Kore, Charon, Leda, …)
# TTS_VOICE_EN=Aoede          # per-language overrides
# TTS_VOICE_HI=Aoede
# TTS_VOICE_TA=Aoede
# TTS_RATE=1.15               # 0.25 – 2.0
# STT_MODEL=latest_short      # latest_short | latest_long | command_and_search
