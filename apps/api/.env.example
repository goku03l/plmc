DATABASE_URL="postgresql://summer:summer@localhost:5433/summer?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Assistant — DeepSeek (Anthropic-compatible API at api.deepseek.com/anthropic)
DEEPSEEK_API_KEY=
# deepseek-flash is the default when DEEPSEEK_API_KEY is set; deepseek-v4-pro is
# the stronger, ~4x pricier model.
# AGENT_MODEL=deepseek-flash
# AGENT_THINKING=on   # adds a reasoning pass (slower + pricier; off by default)

# Fallback provider — used only when DEEPSEEK_API_KEY is empty.
ANTHROPIC_API_KEY=
# AGENT_EFFORT=medium

# Assistant voice (Google Cloud Text-to-Speech, Chirp 3: HD). Optional —
# falls back to the browser voice when unset.
GOOGLE_TTS_API_KEY=
# TTS_VOICE=Aoede
# TTS_RATE=1
